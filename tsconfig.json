{
  "compilerOptions": {
    "strictPropertyInitialization": false,
    "module": "commonjs",
    "target": "es2018",
    "lib": ["es2018"],
    "strict": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@database/*": ["./src/database/*"],
      "@email/*": ["./src/email/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}